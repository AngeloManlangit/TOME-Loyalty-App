rules_version = '2';

// TOME Loyalty — Firestore security rules
//
// Context: before this file, the project ran with NO deployed rules. The app performs exactly two
// Firestore operations today, both reads:
//   1. getDoc(users/{uid})                                    — src/services/userService.ts
//   2. getDocs(query(stamps, where('owner_ID','==',uid)))     — src/services/stampService.ts
// Both are preserved below.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Owner check for docs that carry an owner_ID field.
    // NOTE: for collection queries, Firestore can only satisfy this when the query itself filters on
    // owner_ID == uid. stampService does. Removing that where() clause breaks the read with
    // permission-denied — that is intended, not a bug.
    function ownsResource() {
      return isSignedIn() && resource.data.owner_ID == request.auth.uid;
    }

    // --- users -------------------------------------------------------------------------------------
    // Owner read + write. The app writes nothing here today (signup does not create the doc), but
    // profile editing is a known near-term need, so create/update stay open to the owner.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // --- stamps ------------------------------------------------------------------------------------
    // Owner read only. stamp_count and history are meant to be awarded server-side; no writer exists
    // right now. A client that could write here could mint stamps for free, so writes stay closed.
    match /stamps/{stampId} {
      allow read: if ownsResource();
      allow write: if false;
    }

    // --- default deny ------------------------------------------------------------------------------
    // Firestore denies unmatched paths anyway; this is here so the intent is explicit and so a new
    // collection cannot be reached before someone has thought about its rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
