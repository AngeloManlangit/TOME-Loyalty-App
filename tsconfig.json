{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Jest globals (describe/it/expect/jest) for the suites under src/**/__tests__. Listed
    // explicitly because setting "types" at all disables automatic @types discovery, so expo's own
    // ambient types have to be named here too.
    "types": ["jest", "expo"],
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"],
      "@/*": [
        "./*"
      ],
      "@src/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // functions/ is a separate package with its own tsconfig, Node types and Jest globals. The broad
  // "**/*.ts" include above would otherwise pull server code into the Expo program and fail.
  "exclude": [
    "node_modules",
    "functions"
  ]
}
